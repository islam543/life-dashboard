{
  "name": "life-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite web\"",
    "build": "vite build web",
    "start": "tsx server/index.ts",
    "collect": "tsx server/index.ts --collect",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@hono/node-server": "2.1.5",
    "d3": "7.9.0",
    "dotenv": "18.0.9",
    "hono": "4.13.14",
    "motion": "14.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "topojson-client": "3.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "world-atlas": "2.0.2"
  }
}
