# Copy this file to .env (gitignored) and fill in the blanks.
# Values here are read only by the local server. They are never logged or sent to the web app.

# Jira Cloud. Create a token at id.atlassian.com > Security > API tokens.
# Leave JIRA_EMAIL or JIRA_API_TOKEN empty and the Jira panel shows "not connected".
JIRA_SITE=qicbizdev.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Folder with Daily.md and Agenda/YYYY-MM.md.
LEARNING_DIR=C:\Users\ialab\Desktop\MD Files\Learning

# Knowledge vault. `claude -p` runs here so it can read qic-engineering/ procedures.
VAULT_DIR=C:\Users\ialab\Desktop\MD Files\Working-With-Claude

# Notes written by the dashboard (markdown, one folder per section). Empty means VAULT_DIR\notes,
# so Obsidian sees them. Deleted notes move to NOTES_DIR\.trash, never deleted for good.
NOTES_DIR=

# Claude Code session logs. Empty means the default, ~/.claude/projects
CLAUDE_PROJECTS_DIR=
